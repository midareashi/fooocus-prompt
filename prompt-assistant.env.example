# Copy this file to prompt-assistant.env only if you want to override defaults.
# prompt-assistant.env is ignored by Git. The default uses your Codex desktop sign-in.
FOOOCUS_PROMPT_ASSISTANT_PROVIDER=codex

# Optional overrides:
FOOOCUS_PROMPT_ASSISTANT_TIMEOUT=120

# API alternative (requires separate API access):
# FOOOCUS_PROMPT_ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=your_api_key_here
# FOOOCUS_PROMPT_ASSISTANT_MODEL=gpt-5-mini
